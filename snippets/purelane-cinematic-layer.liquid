{% comment %}
  Global background layer for Purelane homepage cinematic scenes.
{% endcomment %}

{% if template.name == 'index' %}
<style>
  .purelane-cinematic {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: #eee7fb;
    transition: background 1.5s var(--purelane-ease);
  }

  /* Scenes based on data-active-scene */
  .purelane-cinematic[data-active-scene="1"] {
    background: linear-gradient(178deg, #fbfffb 0%, #eafaec 24%, #d6f1dc 54%, #bfe8ca 100%);
  }
  .purelane-cinematic[data-active-scene="2"] {
    background: linear-gradient(178deg, #f6fdf7 0%, #e3f7e7 26%, #cbedd4 58%, #b2e2c2 100%);
  }
  .purelane-cinematic[data-active-scene="3"] {
    background: linear-gradient(178deg, #f0fbf2 0%, #d9f2df 28%, #bde6c8 60%, #a2d9b6 100%);
  }
  .purelane-cinematic[data-active-scene="4"] {
    background: linear-gradient(178deg, #e9f8ec 0%, #cdedd6 30%, #addcbe 62%, #8ecdaa 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .purelane-cinematic {
      transition: none;
    }
  }
</style>

<div id="PurelaneCinematicLayer" class="purelane-cinematic" data-active-scene="1" aria-hidden="true">
  {% comment %} Static fallback is handled by CSS (background: var(--purelane-color-brand)) {% endcomment %}
</div>
{% endif %}
