{{ 'purelane-sections.css' | asset_url | stylesheet_tag }}
{{ 'purelane-components.css' | asset_url | stylesheet_tag }}

<section class="purelane-sec purelane-why-bundles-wrap">
  <div class="purelane-wrap">
    <div class="purelane-glass purelane-panel-head purelane-panel-head-bg">
      <div class="purelane-panel-head-content" style="text-align: center; margin-bottom: 26px;">
        {%- if section.settings.kicker != blank -%}
          <span class="purelane-kicker">{{ section.settings.kicker }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="purelane-d2" style="margin-top: 12px; margin-bottom: 12px;">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      
      <div class="purelane-wb">
        {%- for block in section.blocks -%}
          <div class="purelane-wb-i" {{ block.shopify_attributes }}>
            <div class="purelane-wb-ci">
              {%- if block.settings.custom_svg != blank -%}
                {{ block.settings.custom_svg }}
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg>
              {%- endif -%}
            </div>
            {%- if block.settings.title != blank -%}
              <h4>{{ block.settings.title }}</h4>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p>{{ block.settings.description | newline_to_br }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Bundles Beat Single",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The smarter way to shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why bundles beat buying single"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Benefit Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Benefit description goes here."
        },
        {
          "type": "html",
          "id": "custom_svg",
          "label": "Custom SVG Icon"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Bundles Beat Single",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "title": "Save up to 45%",
            "description": "Versus buying the same products separately",
            "custom_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\"/></svg>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "One flat price",
            "description": "No calculators, no comparing carts",
            "custom_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"/><path d=\"M6 8h12M6 12h12M6 16h6\"/></svg>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Curated by experts",
            "description": "Products picked to work well together",
            "custom_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/><path d=\"M9 12l2 2 4-4\"/></svg>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Free shipping always",
            "description": "Included on every bundle, all India",
            "custom_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"3\" width=\"20\" height=\"14\" rx=\"2\"/><path d=\"M8 21h8M12 17v4\"/></svg>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
