{{ 'purelane-sections.css' | asset_url | stylesheet_tag }}

<section class="purelane-sec purelane-shop-wrap" data-purelane-scene="2">
  <div class="purelane-wrap">
    
    {%- if section.settings.heading != blank or section.settings.kicker != blank -%}
      <div class="purelane-panel-head">
        {%- if section.settings.kicker != blank -%}
          <span class="kicker">{{ section.settings.kicker }}</span>
        {%- endif -%}
        
        {%- if section.settings.heading != blank -%}
          <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
        {%- endif -%}
        
        <div class="rule">
          <i></i>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
          <i></i>
        </div>
      </div>
    {%- endif -%}

    <div class="purelane-shelf">
      {%- assign collection = section.settings.collection -%}
      
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.product_limit -%}
          {% render 'purelane-product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.product_limit) -%}
          {% render 'purelane-product-card', product: blank %}
        {%- endfor -%}
      {%- endif -%}
    </div>
    
    {%- if section.settings.show_view_all and collection != blank and collection.products_count > section.settings.product_limit -%}
      <div class="purelane-view-all">
        {% render 'purelane-button', label: section.settings.view_all_label, url: collection.url, style: 'ghost' %}
      </div>
    {%- endif -%}
    
  </div>
</section>

{% schema %}
{
  "name": "Purelane Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Product Limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' button",
      "default": false
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View all products"
    }
  ],
  "presets": [
    {
      "name": "Purelane Product Grid"
    }
  ]
}
{% endschema %}
