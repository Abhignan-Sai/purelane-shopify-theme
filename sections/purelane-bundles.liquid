{{ 'purelane-sections.css' | asset_url | stylesheet_tag }}

<section class="purelane-sec purelane-bundles-wrap" data-purelane-scene="3">
  <div class="purelane-wrap">
    <div class="purelane-glass purelane-panel-head purelane-panel-head-bg">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="lede" style="margin:0 auto">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>
    
    <div class="purelane-tiers">
      {%- for block in section.blocks -%}
        {%- assign bundle_metaobject = block.settings.bundle -%}
        {%- if bundle_metaobject == blank -%}
          {%- if forloop.index == 1 -%}{%- assign bundle_metaobject = shop.metaobjects.bundle_relationship['most-popular'] -%}
          {%- elsif forloop.index == 2 -%}{%- assign bundle_metaobject = shop.metaobjects.bundle_relationship['best-value'] -%}
          {%- elsif forloop.index == 3 -%}{%- assign bundle_metaobject = shop.metaobjects.bundle_relationship['targeted-clean'] -%}
          {%- endif -%}
        {%- endif -%}
        {%- if bundle_metaobject != blank -%}
          {%- assign is_featured = false -%}
          {%- assign badge_downcase = bundle_metaobject.badge.value | downcase -%}
          {%- if badge_downcase == 'most popular' -%}
            {%- assign is_featured = true -%}
          {%- endif -%}
          {%- render 'purelane-bundle-tier', bundle: bundle_metaobject, is_featured: is_featured -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Bundles",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle Tier",
      "settings": [
        {
          "type": "metaobject",
          "id": "bundle",
          "label": "Bundle Metaobject",
          "metaobject_type": "bundle_relationship"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Bundles",
      "blocks": [
        { "type": "tier" },
        { "type": "tier" },
        { "type": "tier" }
      ]
    }
  ]
}
{% endschema %}
