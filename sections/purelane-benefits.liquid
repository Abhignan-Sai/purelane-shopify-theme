{{ 'purelane-sections.css' | asset_url | stylesheet_tag }}

<section class="purelane-sec purelane-benefits-wrap" id="how" data-purelane-scene="2">
  <div class="purelane-wrap">
    <div class="purelane-pillars">
      {%- for block in section.blocks -%}
        <article class="purelane-glass purelane-pillar purelane-reveal purelane-reveal--d{{ forloop.index }}" {{ block.shopify_attributes }}>
          <span class="purelane-pi">
            {%- if block.settings.custom_svg != blank -%}
              {{ block.settings.custom_svg }}
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg>
            {%- endif -%}
          </span>
          {%- if block.settings.title != blank -%}
            <h3 class="purelane-d3">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <p class="purelane-body-s">{{ block.settings.description | newline_to_br }}</p>
          {%- endif -%}
          {%- if block.settings.cta_label != blank and block.settings.cta_url != blank -%}
            {% render 'purelane-button', label: block.settings.cta_label, url: block.settings.cta_url, style: 'ghost', is_small: true %}
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Three Benefit Cards",
  "settings": [],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Benefit Heading"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Short benefit description."
        },
        {
          "type": "html",
          "id": "custom_svg",
          "label": "Custom SVG Icon",
          "info": "Paste SVG code here."
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button Label",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Button URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Three Benefit Cards",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "title": "Less scrubbing",
            "description": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub.",
            "custom_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"8\" cy=\"8.5\" r=\"3.2\"/><circle cx=\"16.4\" cy=\"6.6\" r=\"2.2\"/><circle cx=\"15\" cy=\"13\" r=\"2.8\"/><circle cx=\"8.6\" cy=\"15.6\" r=\"2.1\"/><path d=\"M4 21h16\"/></svg>",
            "cta_label": "Learn more",
            "cta_url": "#shop"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Clean ingredients",
            "description": "No sulphates, no chlorine, no synthetic fragrance. Nothing on the label you would not want near your food.",
            "custom_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z\"/><path d=\"m9 12 2.2 2.2L15.4 10\"/></svg>",
            "cta_label": "Learn more",
            "cta_url": "#ingredients"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Safe around everyone",
            "description": "Gentle on hands, safe around kids and pets, and it leaves no toxic residue on the surfaces you touch every day.",
            "custom_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 20s-7-4.4-7-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7 2.6c0 5-7 9.4-7 9.4Z\"/></svg>",
            "cta_label": "Learn more",
            "cta_url": "#proof"
          }
        }
      ]
    }
  ]
}
{% endschema %}
