{{ 'purelane-sections.css' | asset_url | stylesheet_tag }}

<section class="purelane-sec purelane-combos-wrap" data-purelane-scene="3">
  <div class="purelane-wrap">
    <div class="purelane-panel-head">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
    
    <div class="purelane-rail">
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        {%- render 'purelane-combo-card', product: product, badge: block.settings.badge, description: block.settings.description -%}
      {%- endfor -%}
    </div>
    
    {%- if section.blocks.size > 1 -%}
      <div class="purelane-swipecue" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
        Swipe for more combos
      </div>
    {%- endif -%}
    
    {%- if section.settings.intro_text != blank -%}
      <p class="purelane-railnote">{{ section.settings.intro_text }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane Combos",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Best-Selling Combos"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pairs perfectly"
    },
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Supporting text",
      "default": "Tapping \"Shop bundle\" opens the bundle picker with these products already added. You can still swap anything before you pay."
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge Text",
          "info": "Overrides default saving calculation"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Supporting copy"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Combos",
      "blocks": [
        { "type": "combo" },
        { "type": "combo" },
        { "type": "combo" }
      ]
    }
  ]
}
{% endschema %}
