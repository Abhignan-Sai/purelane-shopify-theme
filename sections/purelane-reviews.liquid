{{ 'purelane-sections.css' | asset_url | stylesheet_tag }}

<section class="purelane-sec purelane-reviews-wrap" data-purelane-scene="4">
  <div class="purelane-wrap" style="overflow: hidden;">
    <div class="purelane-panel-head">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.supporting_text != blank -%}
        <p class="lede" style="margin:0 auto">{{ section.settings.supporting_text }}</p>
      {%- endif -%}
      
      {%- if section.settings.agg_rating != blank or section.settings.agg_count != blank -%}
        <div class="purelane-reviews-agg">
          {%- if section.settings.agg_rating != blank -%}
            <strong>★ {{ section.settings.agg_rating }}</strong>
          {%- endif -%}
          {%- if section.settings.agg_count != blank -%}
            <span>Based on {{ section.settings.agg_count }} reviews</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
    
    {%- assign has_valid_reviews = false -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.review != blank -%}
        {%- assign has_valid_reviews = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if has_valid_reviews -%}
      <div class="purelane-reviews-rail">
        <div class="purelane-reviews-marquee">
          <div class="purelane-reviews-marquee-track">
            {%- for block in section.blocks -%}
              {%- assign review_metaobject = block.settings.review -%}
              {%- if review_metaobject != blank -%}
                {%- render 'purelane-review-card', review: review_metaobject -%}
              {%- endif -%}
            {%- endfor -%}
            {%- comment -%}Duplicate for infinite scrolling loop{%- endcomment -%}
            {%- for block in section.blocks -%}
              {%- assign review_metaobject = block.settings.review -%}
              {%- if review_metaobject != blank -%}
                {%- render 'purelane-review-card', review: review_metaobject -%}
              {%- endif -%}
            {%- endfor -%}
            {%- comment -%}Triplicate just to be safe on ultra-wide screens if few blocks exist{%- endcomment -%}
            {%- for block in section.blocks -%}
              {%- assign review_metaobject = block.settings.review -%}
              {%- if review_metaobject != blank -%}
                {%- render 'purelane-review-card', review: review_metaobject -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- else -%}
      <div class="purelane-glass" style="text-align: center; padding: 40px; margin-top: 24px; border-radius: 24px;">
        <p style="margin: 0;">No reviews selected. Add Review metaobjects to the blocks in the Theme Editor.</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane Reviews",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 12 lakh+ homes"
    },
    {
      "type": "textarea",
      "id": "supporting_text",
      "label": "Supporting text",
      "default": "Don't just take our word for it."
    },
    {
      "type": "text",
      "id": "agg_rating",
      "label": "Aggregate Rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "agg_count",
      "label": "Aggregate Review Count",
      "default": "8,000+"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "metaobject",
          "id": "review",
          "label": "Review Metaobject",
          "metaobject_type": "review"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
