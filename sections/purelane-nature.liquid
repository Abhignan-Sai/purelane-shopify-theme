{{ 'purelane-sections.css' | asset_url | stylesheet_tag }}

<section class="purelane-sec purelane-nature-wrap" id="ingredients" data-purelane-scene="2">
  <div class="purelane-wrap">
    <div class="purelane-glass purelane-panel-head purelane-panel-head-bg">
      <h2 class="purelane-d2">{{ section.settings.heading }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
      
      <div class="purelane-ing">
        {%- for block in section.blocks -%}
          <div class="purelane-ing__icon" {{ block.shopify_attributes }}>
            <div class="purelane-ing__art">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 150 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" style="max-height: 84px; object-fit: contain;">
              {%- elsif block.settings.custom_svg != blank -%}
                {{ block.settings.custom_svg }}
              {%- endif -%}
            </div>
            {%- if block.settings.title != blank -%}
              <h4>{{ block.settings.title }}</h4>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p>{{ block.settings.description | newline_to_br }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sourced from Nature",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sourced from nature"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Ingredient Name"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Short supporting text."
        },
        {
          "type": "html",
          "id": "custom_svg",
          "label": "Custom SVG",
          "info": "Paste SVG code here. It will be used if no image is selected."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Overrides the SVG if selected."
        }
      ]
    }
  ],
  "presets": [
    {
